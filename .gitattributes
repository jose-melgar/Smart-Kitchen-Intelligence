# Normaliza line endings — evita el ruido CRLF/LF en commits cross-OS.
* text=auto eol=lf

# Texto: forzar LF
*.py        text eol=lf
*.md        text eol=lf
*.tex       text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf

# Datos tabulares: tratar como texto LF
*.csv       text eol=lf
*.tsv       text eol=lf

# Binarios: no tocar
*.npy       binary
*.npz       binary
*.png       binary
*.jpg       binary
*.pdf       binary
*.ipynb     binary
